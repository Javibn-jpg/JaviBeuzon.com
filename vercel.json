{
    "headers": [
      {
        "source": "/docs/(.*\\.pdf)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/pdf"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment"
          },
          {
            "key": "Cache-Control",
            "value": "s-maxage=604800"
          }
        ]
      }
    ]
  }